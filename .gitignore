# Build directories and outputs
build/
build*/
bin/
obj/
dist/
out/
x64/
Win32/

# Large executable binaries & third-party workers (downloaded via scripts/fetch-workers.ps1)
tools/*
!tools/.gitkeep
!tools/win-x64/
tools/win-x64/*
!tools/win-x64/.gitkeep
*.exe
*.dll

# Third-party dependencies & audit artifacts
# Note: third_party/ submodules are registered in .gitmodules

# Release archives and installers (distributed via GitHub Releases, not Git)
*.zip
*.tar.gz
*.7z
*.msix

# Visual Studio / MSVC artifacts
.vs/
*.obj
*.o
*.lib
*.a
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.recipe
*.lastbuildstate
*.VC.db
*.opendb
*.user
*.suo

# CMake artifacts
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake

# Databases, temporary files, logs
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
*.part
*.openidm.part
test_out/
test_*_out/
tmp/
temp/
diagnostics/

# Python & Node.js
__pycache__/
*.pyc
*.pyo
node_modules/
.pytest_cache/
test-results/

# IDE / Editor directories
.vscode/
.idea/
*.swp
*~
redesign/
benchmarks/*local*
benchmarks/test_*
 
benchmarks/real_internet_work/
benchmarks/work_2gb/
benchmarks/fixtures/temp_*

# Raw benchmark trial outputs (preserved in GitHub Actions artifact raw-benchmark-evidence-archive)
benchmarks/results/**/*repeat*.json
benchmarks/**/summary*.json
benchmarks/**/*.csv


# Local helper scripts and transient images
*.torrent
*.png
!installer/msix/Assets/*.png
!extension/icons/*.png
!docs/images/**/*.png
!docs/images/*.png
.agents/
skills-lock.json

