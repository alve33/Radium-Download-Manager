<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>radium</id>
    <version>2.0.0</version>
    <packageSourceUrl>https://github.com/alve33/Radium-Download-Manager/tree/main/installer/chocolatey</packageSourceUrl>
    <owners>alve33</owners>
    <title>Radium Download Manager</title>
    <authors>Radium Contributors</authors>
    <projectUrl>https://github.com/alve33/Radium-Download-Manager</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/alve33/Radium-Download-Manager/main/assets/branding/RDM_Logo.svg</iconUrl>
    <licenseUrl>https://github.com/alve33/Radium-Download-Manager/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/alve33/Radium-Download-Manager</projectSourceUrl>
