  "update_and_release": {
    "update_check_policy": "manual_and_startup",
    "stable_channel": "stable",
    "beta_channel": "beta",
    "github_repo_url": "https://github.com/alve33/Radium-Download-Manager",
    "api_latest_release_url": "https://api.github.com/repos/alve33/Radium-Download-Manager/releases/latest",
    "release_prefix_url": "https://github.com/alve33/Radium-Download-Manager/releases/",
    "min_supported_windows_version": "10.0.17763.0",
    "target_windows_version": "10.0.26100.0"
  },
  "network_policies": {
    "default_connections_per_task": 8,
