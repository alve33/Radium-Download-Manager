  "default_settings": {
    "theme": "system",
    "max_concurrent_tasks": 3,
    "speed_limit_bps": 0,
    "default_connections_per_task": 8,
    "conflict_policy": "prompt",
    "auto_start_downloads": true,
    "stall_timeout_ms": 3000,
    "min_split_bytes": 131072,
    "browser_capture_enabled": true,
    "min_capture_size_bytes": 1048576,
    "close_to_tray": true,
    "start_minimized": false,
    "reduced_motion": false,
    "show_completion_notification": true,
    "av_strict_mode": false,
    "proxy_mode": "system",
    "max_auto_retries": 5,
    "retry_interval_sec": 15,
    "queue_completion_action": "NONE"
  },
