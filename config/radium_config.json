  "errors": {
    "categories": {
      "NETWORK": "Network and socket level transport failures",
      "HTTP": "HTTP and HTTPS protocol failures",
      "STREAM": "HLS, DASH, and stream muxing pipeline errors",
      "STORAGE": "Local disk I/O, SQLite, and file system errors",
      "SECURITY": "Access control, path traversal, and antivirus blocks",
      "TORRENT": "BitTorrent engine and metadata errors",
      "IPC": "Native Messaging and local IPC transport errors",
      "SETTINGS": "Configuration validation and parsing errors"
    },
    "codes": {
      "ERR_NETWORK_TIMEOUT": {
        "category": "NETWORK",
        "description": "The network request timed out"
      },
      "ERR_NET_CONNECT": {
        "category": "NETWORK",
        "description": "Failed to establish TCP connection"
      },
      "ERR_CONNECTION_RESET": {
        "category": "NETWORK",
        "description": "Connection reset by remote peer"
      },
      "ERR_HTTP_404_NOT_FOUND": {
        "category": "HTTP",
        "description": "The requested resource was not found on the server"
      },
      "ERR_HTTP_403_EXPIRED_OR_AUTH": {
        "category": "HTTP",
        "description": "Access forbidden or signed URL expired"
      },
      "ERR_HTTP_5XX_TRANSIENT": {
        "category": "HTTP",
        "description": "Server returned transient 5xx error"
      },
      "ERR_HTTP_VALIDATOR_MISMATCH": {
        "category": "HTTP",
        "description": "ETag or Last-Modified changed unexpectedly during segmented download"
      },
      "ERR_STREAM_DRM_PROTECTED": {
        "category": "STREAM",
        "description": "The media stream is protected by DRM and cannot be downloaded"
      },
      "ERR_STREAM_WORKER_CRASH": {
        "category": "STREAM",
        "description": "Stream extractor or muxing worker exited unexpectedly"
      },
      "ERR_STREAM_INVALID_MANIFEST": {
        "category": "STREAM",
        "description": "Stream manifest could not be parsed"
      },
      "ERR_PATH_TRAVERSAL_REJECTED": {
        "category": "SECURITY",
        "description": "Target path attempted to escape destination directory"
      },
      "ERR_THREAT_DETECTED": {
        "category": "SECURITY",
        "description": "Malicious file or threat detected by antivirus scanner"
      },
      "ERR_DISK_FULL": {
        "category": "STORAGE",
        "description": "Insufficient disk space available for download"
      },
      "ERR_FILE_EXISTS": {
        "category": "STORAGE",
        "description": "Destination file already exists and conflict policy prevented overwrite"
      },
      "ERR_IPC_PIPE_CLAIM": {
        "category": "IPC",
        "description": "Failed to claim first pipe instance for IPC server"
      },
      "ERR_IPC_CAPTURE_DISABLED": {
        "category": "IPC",
        "description": "Browser capture is currently disabled in application settings"
      }
    }
  },
