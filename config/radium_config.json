    "min_split_bytes": 131072,
    "default_resolve_timeout_ms": 5000,
    "default_connect_timeout_ms": 5000,
    "default_send_timeout_ms": 10000,
    "default_recv_timeout_ms": 15000,
    "max_redirect_hops": 10,
    "user_agent": "Radium-Download-Manager"
